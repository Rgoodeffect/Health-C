{
  "doctype": "DocType",
  "name": "Appointment Waiting List",
  "module": "Healthcare ERP",
  "custom": 0,
  "naming_rule": "Expression (old style)",
  "autoname": "hash",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    { "fieldname": "patient", "label": "Patient", "fieldtype": "Link", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "patient_name", "label": "Patient Name", "fieldtype": "Data", "fetch_from": "patient.patient_name", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "practitioner", "label": "Preferred Practitioner", "fieldtype": "Link", "options": "Healthcare Practitioner", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "department", "label": "Department", "fieldtype": "Link", "options": "Medical Department", "in_standard_filter": 1 },
    { "fieldname": "section_break_1", "fieldtype": "Section Break" },
    { "fieldname": "preferred_date", "label": "Preferred Date", "fieldtype": "Date", "in_list_view": 1 },
    { "fieldname": "priority", "label": "Priority", "fieldtype": "Select", "options": "Routine\nUrgent\nEmergency", "default": "Routine", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "column_break_2", "fieldtype": "Column Break" },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Waiting\nContacted\nScheduled\nCancelled", "default": "Waiting", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "added_on", "label": "Added On", "fieldtype": "Datetime", "default": "now", "read_only": 1 },
    { "fieldname": "notes", "label": "Notes", "fieldtype": "Small Text" },
    { "fieldname": "scheduled_appointment", "label": "Scheduled Appointment", "fieldtype": "Link", "options": "Patient Appointment", "read_only": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
