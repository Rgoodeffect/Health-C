{
  "doctype": "DocType",
  "name": "Anesthesia Record",
  "module": "Healthcare ERP",
  "custom": 0,
  "naming_rule": "Random",
  "autoname": "hash",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    { "fieldname": "surgery_request", "label": "Surgery Request", "fieldtype": "Link", "options": "Surgery Request", "reqd": 1, "unique": 1, "in_list_view": 1 },
    { "fieldname": "anesthesiologist", "label": "Anesthesiologist", "fieldtype": "Link", "options": "Healthcare Practitioner", "in_list_view": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "anesthesia_type", "label": "Anesthesia Type", "fieldtype": "Select", "options": "General\nRegional\nLocal\nSedation", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "section_break_1", "fieldtype": "Section Break" },
    { "fieldname": "start_time", "label": "Start Time", "fieldtype": "Datetime" },
    { "fieldname": "end_time", "label": "End Time", "fieldtype": "Datetime" },
    { "fieldname": "column_break_2", "fieldtype": "Column Break" },
    { "fieldname": "asa_class", "label": "ASA Class", "fieldtype": "Select", "options": "I\nII\nIII\nIV\nV\nVI" },
    { "fieldname": "section_break_2", "fieldtype": "Section Break" },
    { "fieldname": "notes", "label": "Notes / Vitals During Anesthesia", "fieldtype": "Text" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
