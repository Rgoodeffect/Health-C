{
  "doctype": "DocType",
  "name": "Bed Transfer Request",
  "module": "Healthcare ERP",
  "custom": 0,
  "naming_rule": "Random",
  "autoname": "hash",
  "sort_field": "requested_on",
  "sort_order": "DESC",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    { "fieldname": "patient", "label": "Patient", "fieldtype": "Link", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "inpatient_record", "label": "Inpatient Record", "fieldtype": "Link", "options": "Inpatient Record", "reqd": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "from_service_unit", "label": "From Bed/Room", "fieldtype": "Link", "options": "Healthcare Service Unit" },
    { "fieldname": "to_service_unit", "label": "To Bed/Room", "fieldtype": "Link", "options": "Healthcare Service Unit", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "section_break_1", "fieldtype": "Section Break" },
    { "fieldname": "reason", "label": "Reason", "fieldtype": "Small Text" },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Requested\nApproved\nCompleted\nRejected", "default": "Requested", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "column_break_2", "fieldtype": "Column Break" },
    { "fieldname": "requested_by", "label": "Requested By", "fieldtype": "Link", "options": "User", "default": "__user", "read_only": 1 },
    { "fieldname": "requested_on", "label": "Requested On", "fieldtype": "Datetime", "default": "now", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "approved_by", "label": "Approved By", "fieldtype": "Link", "options": "User", "read_only": 1 },
    { "fieldname": "completed_on", "label": "Completed On", "fieldtype": "Datetime", "read_only": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
