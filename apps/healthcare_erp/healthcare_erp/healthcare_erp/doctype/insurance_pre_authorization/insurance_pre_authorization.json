{
  "doctype": "DocType",
  "name": "Insurance Pre Authorization",
  "module": "Healthcare ERP",
  "custom": 0,
  "naming_rule": "Expression (old style)",
  "autoname": "naming_series:",
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    { "fieldname": "naming_series", "label": "Series", "fieldtype": "Select", "options": "PA-.YYYY.-.#####", "default": "PA-.YYYY.-.#####", "reqd": 1 },
    { "fieldname": "patient", "label": "Patient", "fieldtype": "Link", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "insurance_company", "label": "Insurance Company", "fieldtype": "Link", "options": "Healthcare Insurance Company", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "coverage_plan", "label": "Coverage Plan", "fieldtype": "Link", "options": "Healthcare Insurance Coverage Plan" },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "procedure_or_service", "label": "Procedure / Service", "fieldtype": "Data", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "estimated_cost", "label": "Estimated Cost", "fieldtype": "Currency" },
    { "fieldname": "requested_date", "label": "Requested Date", "fieldtype": "Date", "default": "Today" },
    { "fieldname": "section_break_1", "fieldtype": "Section Break" },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Requested\nApproved\nDenied\nExpired", "default": "Requested", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "auth_number", "label": "Authorization Number", "fieldtype": "Data", "in_list_view": 1 },
    { "fieldname": "valid_until", "label": "Valid Until", "fieldtype": "Date" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
