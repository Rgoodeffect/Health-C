{
  "doctype": "DocType",
  "name": "Surgery Request",
  "module": "Healthcare ERP",
  "custom": 0,
  "naming_rule": "Expression (old style)",
  "autoname": "naming_series:",
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    { "fieldname": "naming_series", "label": "Series", "fieldtype": "Select", "options": "SURG-.YYYY.-.#####", "default": "SURG-.YYYY.-.#####", "reqd": 1 },
    { "fieldname": "patient", "label": "Patient", "fieldtype": "Link", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "patient_name", "label": "Patient Name", "fieldtype": "Data", "fetch_from": "patient.patient_name", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "procedure", "label": "Procedure", "fieldtype": "Data", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "requested_by", "label": "Requested By", "fieldtype": "Link", "options": "Healthcare Practitioner" },
    { "fieldname": "requested_date", "label": "Requested Date", "fieldtype": "Date", "default": "Today" },
    { "fieldname": "priority", "label": "Priority", "fieldtype": "Select", "options": "Elective\nUrgent\nEmergency", "default": "Elective", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Requested\nScheduled\nIn Progress\nCompleted\nCancelled", "default": "Requested", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "section_break_1", "fieldtype": "Section Break", "label": "Surgical Team" },
    { "fieldname": "team_members", "label": "Team Members", "fieldtype": "Table", "options": "Surgical Team Member" },
    { "fieldname": "section_break_2", "fieldtype": "Section Break" },
    { "fieldname": "notes", "label": "Notes", "fieldtype": "Small Text" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
