{
  "doctype": "DocType",
  "name": "Nursing Note",
  "module": "Healthcare ERP",
  "custom": 0,
  "naming_rule": "Random",
  "autoname": "hash",
  "sort_field": "recorded_on",
  "sort_order": "DESC",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    { "fieldname": "patient", "label": "Patient", "fieldtype": "Link", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "inpatient_record", "label": "Inpatient Record", "fieldtype": "Link", "options": "Inpatient Record", "in_standard_filter": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "shift", "label": "Shift", "fieldtype": "Select", "options": "Morning\nEvening\nNight", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "recorded_by", "label": "Recorded By", "fieldtype": "Link", "options": "User", "default": "__user", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "recorded_on", "label": "Recorded On", "fieldtype": "Datetime", "default": "now", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "section_break_1", "fieldtype": "Section Break" },
    { "fieldname": "note", "label": "Note", "fieldtype": "Text Editor", "reqd": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
