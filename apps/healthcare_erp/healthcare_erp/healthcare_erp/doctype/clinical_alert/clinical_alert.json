{
  "doctype": "DocType",
  "name": "Clinical Alert",
  "module": "Healthcare ERP",
  "custom": 0,
  "naming_rule": "Random",
  "autoname": "hash",
  "sort_field": "raised_on",
  "sort_order": "DESC",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    { "fieldname": "patient", "label": "Patient", "fieldtype": "Link", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "patient_name", "label": "Patient Name", "fieldtype": "Data", "fetch_from": "patient.patient_name", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "severity", "label": "Severity", "fieldtype": "Select", "options": "Info\nWarning\nCritical", "default": "Warning", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "message", "label": "Message", "fieldtype": "Small Text", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "source_doctype", "label": "Source Doctype", "fieldtype": "Link", "options": "DocType", "read_only": 1 },
    { "fieldname": "source_name", "label": "Source Document", "fieldtype": "Dynamic Link", "options": "source_doctype", "read_only": 1 },
    { "fieldname": "raised_on", "label": "Raised On", "fieldtype": "Datetime", "default": "now", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "section_break_1", "fieldtype": "Section Break" },
    { "fieldname": "acknowledged", "label": "Acknowledged", "fieldtype": "Check", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "acknowledged_by", "label": "Acknowledged By", "fieldtype": "Link", "options": "User", "read_only": 1 },
    { "fieldname": "acknowledged_on", "label": "Acknowledged On", "fieldtype": "Datetime", "read_only": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
