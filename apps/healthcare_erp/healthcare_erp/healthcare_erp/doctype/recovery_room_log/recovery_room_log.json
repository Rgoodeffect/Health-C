{
  "doctype": "DocType",
  "name": "Recovery Room Log",
  "module": "Healthcare ERP",
  "custom": 0,
  "naming_rule": "Random",
  "autoname": "hash",
  "sort_field": "admitted_time",
  "sort_order": "DESC",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    { "fieldname": "surgery_request", "label": "Surgery Request", "fieldtype": "Link", "options": "Surgery Request", "reqd": 1, "unique": 1, "in_list_view": 1 },
    { "fieldname": "patient", "label": "Patient", "fieldtype": "Link", "options": "Patient", "fetch_from": "surgery_request.patient", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "admitted_time", "label": "Admitted to Recovery", "fieldtype": "Datetime", "default": "now" },
    { "fieldname": "discharge_time", "label": "Discharged from Recovery", "fieldtype": "Datetime" },
    { "fieldname": "section_break_1", "fieldtype": "Section Break" },
    { "fieldname": "vitals_stable", "label": "Vitals Stable", "fieldtype": "Check", "in_list_view": 1 },
    { "fieldname": "pain_score", "label": "Pain Score (0-10)", "fieldtype": "Int" },
    { "fieldname": "notes", "label": "Notes", "fieldtype": "Small Text" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
