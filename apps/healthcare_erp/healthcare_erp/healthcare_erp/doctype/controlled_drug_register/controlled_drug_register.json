{
  "doctype": "DocType",
  "name": "Controlled Drug Register",
  "module": "Healthcare ERP",
  "custom": 0,
  "naming_rule": "Random",
  "autoname": "hash",
  "sort_field": "dispensed_on",
  "sort_order": "DESC",
  "track_changes": 1,
  "engine": "InnoDB",
  "fields": [
    { "fieldname": "dispensing_log", "label": "Dispensing Log", "fieldtype": "Link", "options": "Dispensing Log", "reqd": 1, "unique": 1, "in_list_view": 1 },
    { "fieldname": "drug", "label": "Drug", "fieldtype": "Link", "options": "Item", "fetch_from": "dispensing_log.drug", "read_only": 1, "in_list_view": 1 },
    { "fieldname": "schedule", "label": "Schedule / Class", "fieldtype": "Data", "in_list_view": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "quantity_dispensed", "label": "Quantity Dispensed", "fieldtype": "Float", "fetch_from": "dispensing_log.quantity", "read_only": 1 },
    { "fieldname": "balance_before", "label": "Register Balance Before", "fieldtype": "Float" },
    { "fieldname": "balance_after", "label": "Register Balance After", "fieldtype": "Float" },
    { "fieldname": "section_break_1", "fieldtype": "Section Break" },
    { "fieldname": "witnessed_by", "label": "Witnessed By", "fieldtype": "Link", "options": "User", "reqd": 1 },
    { "fieldname": "dispensed_on", "label": "Dispensed On", "fieldtype": "Datetime", "default": "now", "read_only": 1, "in_list_view": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
