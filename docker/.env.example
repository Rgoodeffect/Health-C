# Copy to docker/.env and fill in real values before `docker compose up`.
# Never commit the real .env file.

# --- Frappe/ERPNext version pins ---
ERPNEXT_VERSION=version-16

# --- Site ---
SITE_NAME=healthc.local
FRONTEND_URL=http://localhost

# --- Secrets (generate strong random values for production) ---
DB_ROOT_PASSWORD=change-me-strong-password
ADMIN_PASSWORD=change-me-strong-password

# --- Nginx ---
HTTP_PORT=80
